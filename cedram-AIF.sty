  \authors\unskip\ifx\@empty\thankses\else
  \kern3pt(*)\fi
  \ifx\@empty\redactor@contribs
  \else \vskip6pt \@setredactor@contribs
  \fi
  \ifx\@empty\appendixwriter@contribs
  \else \vskip6pt \@setappendixwriter@contribs
  \fi
  \endtrivlist
  \vskip0.6cm
  \endgroup
}
